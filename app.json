{
  "expo": {
    "name": "Nöbetçi",
    "slug": "nobetci",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nobetci.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sana en yakın nöbetçi eczaneyi gösterebilmek için konumunu kullanıyoruz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D58A6A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cc2dotcom.nobetcieczane",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "nobetci",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sana en yakın nöbetçi eczaneyi gösterebilmek için konumunu kullanıyoruz."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "owner": "cc2dotcom",
    "extra": {
      "eas": {
        "projectId": "cb4a84d3-3be3-404d-b7cb-e34bf49f63c5"
      }
    }
  }
}
